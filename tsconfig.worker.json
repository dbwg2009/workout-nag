{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["worker/**/*.ts", "src/db/**/*.ts", "src/core/**/*.ts", "src/nag/**/*.ts"],
  "exclude": ["node_modules", "app", "test", ".next"]
}
