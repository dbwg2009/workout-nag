{
  "name": "workout-nag",
  "version": "1.0.0",
  "private": true,
  "description": "Sarge — a self-hosted, free, relentless-but-fair workout accountability bot for Discord.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:worker": "tsx watch worker/index.ts",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:worker": "node dist/worker/index.js",
    "dev:web": "next dev",
    "build:web": "next build",
    "start:web": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "exifr": "^7.1.3",
    "luxon": "^3.5.0",
    "next": "^15.1.6",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
