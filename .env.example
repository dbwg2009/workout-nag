# ---- Database ----
DATABASE_URL=postgres://postgres:postgres@db:5432/workout_nag

# ---- Discord (you create these) ----
# 1. https://discord.com/developers/applications -> New Application -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here
# 2. Enable "Message Content Intent" on the Bot page
# 3. Right-click your own Discord name -> Copy User ID (enable Developer Mode in settings first)
DISCORD_USER_ID=your-discord-user-id
# 4. The channel the bot should nag you in (right-click channel -> Copy Channel ID).
#    Leave blank to have the bot DM you instead (you must share a server with it).
DISCORD_CHANNEL_ID=

# ---- OpenRouter (you provide this) ----
# https://openrouter.ai/keys  — leave blank and Sarge falls back to built-in static messages
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Behaviour (sensible defaults; override if you like) ----
TZ=Europe/London
WAKE_START=09:00
WAKE_END=21:00
MAX_NAGS_PER_DAY=6
# Training days as 3-letter lowercase, comma separated (from your 8-week plan)
TRAINING_DAYS=tue,thu,fri,sat
# Plan start date (used for week/session context in messages)
PLAN_START=2026-06-02
PERSONA_NAME=Sarge

# ---- Web dashboard ----
DASHBOARD_PORT=3000

# ---- Training site access (PIN keypad) ----
# Gate the dashboard + /plan behind an on-screen PIN. Leave SITE_PIN or
# SITE_AUTH_TOKEN blank to disable the gate entirely (open site).
SITE_PIN=2911
# Cookie token set after a correct PIN. CHANGE THIS for anything internet-facing
# (run: openssl rand -hex 32). A 4-digit PIN is a light gate, not real security —
# keep the site on your LAN / behind your own proxy.
SITE_AUTH_TOKEN=fdf3b0525a0f34e7966529ac423d71116437f5408179bc3e7a7ce216ca03d6de

# Timer push feature
TIMER_PUSH_ENABLED=true
TIMER_MAX_PUSH_SECONDS=15
